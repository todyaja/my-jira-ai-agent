# =========================================
# Jira
# =========================================

JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ACCOUNT_ID=

# How often to search Jira for issues awaiting a PRD
JIRA_POLL_INTERVAL_SECONDS=60

# =========================================
# Confluence (PRDs and TRDs are published here and linked from the Jira issue)
# =========================================

# Space the PRD and TRD pages are created in, e.g. ENG (required)
CONFLUENCE_SPACE_KEY=
# Optional page ID to create pages under; empty puts them at the space root
CONFLUENCE_PARENT_PAGE_ID=
# Optional overrides; each defaults to the matching JIRA_ value
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# =========================================
# Git
# =========================================

# Repository the Planning step reads to write the TRD (absolute, or relative
# to where the server is started)
REPO_PATH=
# Branch implementation branches (feature/<ISSUE-KEY>) start from
BASE_BRANCH=main
# Optional directory for the per-issue worktrees; defaults to <REPO_PATH>-worktrees
# beside the repository, so the main checkout is never touched
WORKTREES_PATH=

# =========================================
# GitHub
# =========================================

# Pull requests are opened when an issue reaches PR Ready: the branch is
# pushed to origin with git's own credentials, then the pull request into
# BASE_BRANCH is opened with this token. An empty token turns this off.
GITHUB_OWNER=
# The repository name, owner/repo, or its URL
GITHUB_REPO=
# Fine-grained token with Pull requests: read and write on the repository
GITHUB_TOKEN=

# =========================================
# Claude Code CLI (uses your logged-in Claude plan)
# =========================================

# Path to the claude executable; defaults to "claude" on PATH
CLAUDE_COMMAND=
# Optional model alias or name, e.g. opus or sonnet; empty uses your CLI default
CLAUDE_MODEL=
CLAUDE_TIMEOUT_SECONDS=300
# The technical planner reads the repository at REPO_PATH, so it gets longer
CLAUDE_PLANNING_TIMEOUT_SECONDS=900
CLAUDE_IMPLEMENTATION_TIMEOUT_SECONDS=1800
CLAUDE_REVIEW_TIMEOUT_SECONDS=900
# The engineer and reviewer checks are worked out from the worktree before each
# run: the package.json test/lint/typecheck/build scripts (or go build/vet/test,
# or mvn test for Maven),
# run inside the repository's Docker Compose service when it has one and Docker
# is running, and on this machine otherwise.
# Comma-separated extra command prefixes they may run; empty uses
# git status/diff/log/show
CLAUDE_ALLOWED_COMMANDS=

# =========================================
# Orchestrator
# ========================================= 

# Health endpoint port; give each team's server its own
PORT=8080
# AI review rounds per implementation (per repository in the bank workflow)
MAX_REVIEW_CYCLES=3
# scrum (PRD > TRD > implementation, the default) or bank (see below)
WORKFLOW=scrum

# =========================================
# Bank workflow (WORKFLOW=bank)
# =========================================
# Statuses: Back Log > Request RFC > RFC Review > Request TRD > TRD Review >
# Ready To Implement > Implementing > AI Review > Engineer Review > PR Review >
# Development Done > FSD Request > FSD Review > Runbook Request >
# Runbook Review > Go Live, plus AI ERROR. Each ticket lists the repositories
# it changes as a checklist in its description, ticking the ones that change.
# REPO_PATH, BASE_BRANCH (as the default) and GITHUB_* are not used.

# Folder holding the team's repositories; tickets name them by folder name.
# Repositories are found up to three folders deep, e.g. C:Codeseses-busi
REPOS_ROOT=
# Base branch of every repository unless REPO_BASE_BRANCHES names another;
# defaults to master in the bank workflow
# BASE_BRANCH=master
# Comma-separated name=branch overrides, e.g. bnc-sump-server=sit-merge-all
REPO_BASE_BRANCHES=
# Where the RFC, FSD and runbook writers run, i.e. where the make-fsd and
# make-runbook skills keep their RFCs, FSDs and RunBooks folders; defaults to
# REPOS_ROOT
DOCS_DIR=
# The user's Claude skills folder; defaults to ~/.claude/skills
SKILLS_DIR=
# Merge requests are opened in PR Review: each branch is pushed with git's own
# credentials, then the merge request is opened with this token (api scope).
# The GitLab project comes from each repository's origin remote. An empty
# token turns this off.
GITLAB_URL=
GITLAB_TOKEN=
